# --- Core ---
APP_ENV=development
SECRET_KEY=change-me-to-a-strong-random-32byte-secret
ACCESS_TOKEN_TTL_MIN=60

# --- Data stores ---
# Local/offline default is SQLite; production uses Postgres+PostGIS.
DATABASE_URL=sqlite:///./sahulat.db
# DATABASE_URL=postgresql+psycopg2://sahulat:sahulat@localhost:5432/sahulat
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# --- Auth / OTP ---
OTP_TTL_SECONDS=180
OTP_PROVIDER=mock            # mock | sms | whatsapp
EXPOSE_DEBUG_OTP=true        # dev only: never true in production

# --- External providers (mock by default) ---
NADRA_PROVIDER=mock          # mock | live
PAYMENT_PROVIDER=mock        # mock | easypaisa | jazzcash
STT_PROVIDER=local            # mock | local  (local = offline faster-whisper, voice/BO-4)
PUSH_PROVIDER=mock           # mock | fcm | apns

# --- Voice / Speech-to-Text (used only when STT_PROVIDER=local) ---
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3 (small = better Urdu; medium is even better but slower on CPU)
WHISPER_DEVICE=cpu           # cpu | cuda
WHISPER_COMPUTE_TYPE=int8    # int8 (CPU) | float16 (GPU)
WHISPER_LANG_DEFAULT=ur
# On low C:-disk machines, cache the ~140 MB model on another drive (e.g. D:):
# WHISPER_DOWNLOAD_ROOT=D:/sahulat_models/whisper

# --- Business rules ---
PLATFORM_FEE_PCT=0.10
MATCH_DEFAULT_RADIUS_KM=10
MATCH_MAX_RADIUS_KM=15
EMERGENCY_RADIUS_KM=5
BIOMETRIC_THRESHOLD=0.75

# --- Bidding engine ---
BID_MAX_ROUNDS=5
BID_CONVERGE_PKR=500

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Provider secrets (injected in prod; never commit real values) ---
# NADRA_API_KEY=
# EASYPAISA_KEY=
# JAZZCASH_KEY=
# SMS_API_KEY=
# FCM_KEY=
